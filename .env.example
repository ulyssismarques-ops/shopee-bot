# ─── WHATSAPP ────────────────────────────────────────────────────────────────
# Preencher APÓS primeiro login — ID aparece nos logs
WHATSAPP_GROUP_ID=

# ─── SHOPEE AFILIADA ─────────────────────────────────────────────────────────
# Login do portal affiliate.shopee.com.br
SHOPEE_USERNAME=rosanaro2021
SHOPEE_PASSWORD=           ← cole a senha aqui (só no Railway, nunca no GitHub)

# Fallback: só o af_id (se o login via API não funcionar)
# Pegar em qualquer link gerado pelo portal → parâmetro af_id=XXXX na URL
SHOPEE_AF_ID=

# ─── PATHS (não mude se usar Railway Volume em /data) ────────────────────────
AUTH_PATH=/data/baileys_auth
HISTORICO_PATH=/data/historico.json

# ─── INSTAGRAM (Meta Graph API) ──────────────────────────────────────────────
# Como obter: developers.facebook.com → seu app → Instagram Graph API
# Perfil @byrosanamatias — beleza e estética
INSTAGRAM_BELEZA_USER_ID=     ← ID numérico da conta byrosanamatias
INSTAGRAM_BELEZA_TOKEN=       ← token de longa duração (60 dias)

# Perfil @achadinhosdaroh01 — produtos gerais
INSTAGRAM_GERAL_USER_ID=      ← ID numérico da conta achadinhosdaroh01
INSTAGRAM_GERAL_TOKEN=        ← token de longa duração (60 dias)

# ─── TIMEZONE ────────────────────────────────────────────────────────────────
TZ=America/Sao_Paulo
