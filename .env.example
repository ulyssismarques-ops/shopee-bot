# ═══════════════════════════════════════════════════════════════════════════
#  Shopee Bot — variáveis de ambiente (Railway → Variables)
# ═══════════════════════════════════════════════════════════════════════════
#  Este arquivo serve só como REFERÊNCIA. Valores reais ficam no Railway.
#  NUNCA commitar credenciais reais aqui.

# ─── WhatsApp ────────────────────────────────────────────────────────────────
# Preencher APÓS primeiro login — ID aparece nos logs
WHATSAPP_GROUP_ID=
# Link de convite do grupo VIP (chat.whatsapp.com/...) — usado no Status WA + landing
WHATSAPP_GROUP_INVITE_URL=

# ─── Shopee Afiliada ─────────────────────────────────────────────────────────
SHOPEE_USERNAME=rosanaro2021
SHOPEE_PASSWORD=                       # senha (só no Railway)
SHOPEE_AF_ID=                          # fallback se login API não funcionar
# URL do feed CSV — único ponto de manutenção, pode expirar e precisar atualizar
SHOPEE_FEED_URL=

# ─── Paths persistentes (não mude se usar Railway Volume em /data) ──────────
AUTH_PATH=/data/baileys_auth
HISTORICO_PATH=/data/historico.json

# ─── Instagram (Meta Graph API) ──────────────────────────────────────────────
# Page Access Tokens (EAA...) — não expiram quando obtidos via long-lived User Token
# Como obter: developers.facebook.com → app "Achadinhos da Roh" → Graph API Explorer
INSTAGRAM_BELEZA_USER_ID=               # ID Instagram Business de @byrosanamatias
INSTAGRAM_BELEZA_TOKEN=                 # Page Token da página Sarah Marques
INSTAGRAM_GERAL_USER_ID=                # ID Instagram Business de @achadinhosdaroh01
INSTAGRAM_GERAL_TOKEN=                  # Page Token da página Achadinhos da Roh

# ─── Landing page + Reels (v3.18+) ───────────────────────────────────────────
# URL pública do serviço Railway — usada pra Meta API baixar vídeos de Reel e
# imagens de Story que o bot gera via ffmpeg. Sem isso, Reels e Stories falham.
RAILWAY_PUBLIC_URL=https://shopee-bot-production-e39e.up.railway.app

# ─── Sistema ─────────────────────────────────────────────────────────────────
TZ=America/Sao_Paulo

# ─── Flags de debug (opcional) ───────────────────────────────────────────────
# TESTAR_AGORA=true  → dispara TODOS os canais 10s após boot (WhatsApp, IG geral,
#                       IG beleza, Reels). ⚠️  REMOVA depois do teste senão
#                       dispara extra a cada redeploy.
